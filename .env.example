# ─────────────────────────────────────────────────────────────
# PJPC 系统环境变量模板
#
# 用法：复制成 .env.local 再填值
#   cp .env.example .env.local
# 填完跑一次自检（缺项会一次列全）：
#   node scripts/check-env.mjs
#
# 注意：.env.local 永远不要提交进 git（已在 .gitignore 里）
# ─────────────────────────────────────────────────────────────

# ── 必需 ─────────────────────────────────────────────────────

# PocketBase 服务地址（内网即可，不要对公网开放）
POCKETBASE_URL=http://127.0.0.1:8090

# PocketBase 超级管理员（服务端用它读写数据库，见 PB 后台 _superusers）
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# Next.js 内部代理用的共享密钥（随机 32 位以上，生成：openssl rand -hex 32）
PROXY_INTERNAL_KEY=

# 代理/自动化脚本用的令牌（随机 32 位以上）
PJPC_AGENT_TOKEN=

# ── 可选（不填用默认值）────────────────────────────────────

# 站点对外地址，用于生成发票/收据里的链接与二维码
# SITE_URL=https://abc.pjpcapp.com

# 品牌与地区（任务 2 会真正读取，先占位）
# BRAND_NAME=安心安亲
# CURRENCY=MYR
# TIMEZONE=Asia/Kuala_Lumpur

# ── 外部集成（不用就留空）──────────────────────────────────

# 邮件（发收据/通知）
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# WhatsApp Cloud API（家长通知）
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# TNB 电费抓取（可选，只要水电费模块才需要）
# TNB_EMAIL=
# TNB_PASSWORD=

# Air Selangor 水费抓取（可选）
# AIR_LOGIN_ID=
# AIR_PASSWORD=

# ── 只读集成（自动化脚本用）────────────────────────────────

# 外部读取用的只读令牌
# PJPC_READ_TOKEN=
